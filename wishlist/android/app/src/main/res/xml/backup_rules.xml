<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde Android 11 et moins. La session Supabase (jetons) vit dans les
     SharedPreferences : restaurée sur une réinstallation ou un autre appareil,
     son jeton de rafraîchissement est déjà consommé et Supabase la refuse
     (WISHY-3). Les données de l'app sont sur le serveur : rien à restaurer. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
</full-backup-content>
