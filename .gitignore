# Root .gitignore. The Flutter app has its own rules in wishlist/.gitignore.

# OS / editors
.DS_Store
.idea/
*.iml

# Node (scripts/)
node_modules/

# Secrets: a plain .env is never committed.
# wishlist/env/.env.dev and .env.prod are tracked on purpose (encrypted with transcrypt).
.env
.env.local
.env.*.local

# Build output (wishlist/android/build/, wishlist/ios/build/)
build/

# Supabase CLI local state (backstop for supabase/.gitignore)
.branches/
.temp/

# Local state of the former supabase-dev/ and supabase-prod/ projects (project
# refs, database host and user), left behind by the CLI in existing clones
/supabase-dev/supabase/.temp/
/supabase-dev/supabase/.branches/
/supabase-prod/supabase/.temp/
/supabase-prod/supabase/.branches/

# Dump written by scripts/migrate_data_dev_to_prod.sh (left behind if the script fails)
data_dump.sql
