# Root .gitignore. The Flutter app has its own rules in wishlist/.gitignore.

# OS / editors
.DS_Store
.idea/
*.iml

# Node (scripts/)
node_modules/

# Secrets: any .env* file is ignored (.env, .env.keys, .env.production, ...).
# wishlist/env/.env.dev and .env.prod are tracked on purpose (encrypted with transcrypt).
.env*
!wishlist/env/.env.dev
!wishlist/env/.env.prod

# Build output of the native platforms (wishlist/build/ is in wishlist/.gitignore)
/wishlist/android/build/
/wishlist/android/app/build/
/wishlist/ios/build/

# Supabase CLI local state (project refs, database host and user). The wildcard
# also covers the former supabase-dev/ and supabase-prod/ folders, which the CLI
# left behind in existing clones.
**/supabase/.branches/
**/supabase/.temp/

# Dump written by scripts/migrate_data_dev_to_prod.sh (left behind if the script fails)
data_dump.sql
