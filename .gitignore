# Root .gitignore. The Flutter app has its own rules in wishlist/.gitignore.

# OS / editors
.DS_Store
.idea/
*.iml

# Node (scripts/)
node_modules/

# Secrets: a plain .env is never committed.
# wishlist/env/.env.dev and .env.prod are tracked on purpose (encrypted with transcrypt).
.env
.env.local
.env.*.local

# Build output (wishlist/android/build/, wishlist/ios/build/)
build/

# Supabase CLI local state (backstop for supabase*/supabase/.gitignore)
.branches/
.temp/
